# Entornos virtuales
.venv/
venv/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class

# Bases de datos y archivos de prueba
*.db
*.db-journal
test_*.txt
test_*.db

# Docker / Logs
data/
*.log

# IDEs y SO
.vscode/
.idea/
.DS_Store

# Claves privadas
WM_Registry/certs/*_key.pem
WM_Central/certs/*_key.pem

# Certificados TLS: cada despliegue genera el suyo al primer arranque (con los SAN de esa
# máquina) y lo reutiliza; se copian a los clientes, no se versionan.
WM_Registry/certs/registry_cert.pem
WM_Central/certs/central_cert.pem

# Credenciales locales de las estaciones (WM_WS_M)
WM_WS/.credentials/

# Estado local del Engine (último número de secuencia de órdenes aceptado por clave)
WM_WS/.engine_state/
*.cred
